{
  "name": "ludex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Game Finder & Recommendation Hub — find what to play next across PC, PS5, Switch and Switch 2.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "node skills/data-pipeline/validate-dataset.mjs",
    "data:art": "node skills/data-pipeline/enrich-art.mjs",
    "data:verify-art": "node skills/data-pipeline/verify-art.mjs",
    "data:stats": "node skills/data-pipeline/stats.mjs",
    "shot": "node skills/screenshot/capture.mjs",
    "check": "node skills/screenshot/console-check.mjs",
    "flows": "node skills/screenshot/flows.mjs",
    "data:audit-steam": "node skills/data-pipeline/audit-steam-ids.mjs",
    "data:report": "node skills/data-pipeline/audit-report.mjs",
    "data:prices": "node skills/data-pipeline/fetch-prices.mjs",
    "data:store-slugs": "node skills/data-pipeline/resolve-store-slugs.mjs",
    "data:steam-ids": "node skills/data-pipeline/resolve-steam-ids.mjs"
  },
  "dependencies": {
    "motion": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
